{% extends 'baseCliente.html.jinja' %}

{% block content %}
<h1>{% block title %} Realice sus encargos {% endblock %}</h1>
    
<table id="formcenter">
    <tr>
        <th>ID de Producto</th>
        <th>Nombre</th>
        <th>Descripción</th>
        <th>Categoría</th>
        <th>Dimensiones</th>
        <th>Peso</th>
        <th>Precio</th>
        <th>Imagen</th>
    </tr>
    {% for product in Products %}
    <tr>
        <td>{{ product.id_producto }}</td>
        <td>{{ product.nombre }}</td>
        <td>{{ product.descripcion }}</td>
        <td>{{ product.categoria }}</td>
        <td>{{ product.dimensiones }}</td>
        <td>{{ product.peso }}</td>
        <td>{{ product.precio_unitario }}</td>
        <td><img src="/{{product.imagen}}" alt="{{ product.nombre }}" width="100"></td>

        <td>
            <button onclick="window.location.href='/charge/client/request/{{ product.id_producto }}'">Solicitar</button>
        </td>

        <td>
            <button onclick="window.location.href='/calificar/{{ product.id_producto }}'">Calificar</button>
        </td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
