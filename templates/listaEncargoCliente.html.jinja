
{% extends 'baseCliente.html.jinja' %}

{% block content %}
<h1>{% block title %} Sus encargos {% endblock %}</h1>
    
<table id="formcenter">
    <tr>
        <th>ID del encargo</th>
        <th>Producto</th>
        <th>Fecha</th>
        <th>Monto</th>
        <th>Unidades</th>
        <th>Método de envio</th>
        <th>Estado</th>
        <th>Imagen</th>
    </tr>
    {% for encargo, product in Encargos %}
    <tr>
        <td>{{ encargo.id_encargo }}</td>
        <td>{{ product.nombre }}</td>
        <td>{{ encargo.fecha_encargo }}</td>
        <td>{{ encargo.monto_total }}</td>
        <td>{{ encargo.cantidad_productos }}</td>
        <td>{{ encargo.metodo_envio }}</td>
        <td>{{ encargo.estado }}</td>
        <td><img src="/{{ product.imagen }}" alt="{{ product.nombre }}" width="100"></td>
        <td>
            <div>
                <form action="/encargo/delete/{{ encargo.id_encargo }}" method="post" style="display:inline;">
                <input type="hidden" class="form-control" name="encargo_id" value="{{ encargo.id_encargo }}">
                <button type="submit">Eliminar</button>
            </form>
            <div>
                <form action="/encargo/client/accept/" method="post" style="display:inline;">
                <input type="hidden" class="form-control" name="id_encargo" value="{{ encargo.id_encargo }}">
                <input type="hidden" class="form-control" name="id_producto" value="{{ product.id_producto }}">
                <input type="hidden" class="form-control" name="cantidad_productos" value="{{ encargo.cantidad_productos }}">
                <input type="hidden" class="form-control" name="metodo_envio" value="{{ encargo.metodo_envio }}">
                <input type="hidden" class="form-control" name="monto_total" value="{{ encargo.monto_total }}">
                <input type="hidden" class="form-control" name="fecha_encargo" value="{{ encargo.fecha_encargo }}">
                <button type="submit">Aceptar</button>
            </form>
        </td>
    </tr>
    {% endfor %}
</table>
{% endblock %}