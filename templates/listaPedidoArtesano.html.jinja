{% extends 'baseCliente.html.jinja' %}

{% block content %}
<h1>{% block title %} Sus pedidos {% endblock %}</h1>
    
<table id="formcenter">
    <tr>
        <th>ID del pedido</th>
        <th>Producto</th>
        <th>Fecha</th>
        <th>Monto</th>
        <th>Unidades</th>
        <th>Método de envio</th>
        <th>Estado</th>
        <th>Imagen</th>
    </tr>
    {% for order, product in Orders %}
    <tr>
        <td>{{ order.id_pedido }}</td>
        <td>{{ product.nombre }}</td>
        <td>{{ order.fecha_pedido }}</td>
        <td>{{ order.monto_total }}</td>
        <td>{{ order.cantidad_productos }}</td>
        <td>{{ order.metodo_envio }}</td>
        <td>{{ order.estado }}</td>
        <td><img src="/{{ product.imagen }}" alt="{{ product.nombre }}" width="100"></td>
        <td>
           
           <button value="Cotizar" onclick="window.location.href='/order/artesan/update/{{order.id_pedido}}' ;" >Cotizar</button> 
            <br>
        </td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
